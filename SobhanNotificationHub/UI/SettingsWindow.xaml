<Window x:Class="SobhanNotificationHub.UI.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="تنظیمات اعلان" Height="540" Width="640" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"><ScrollViewer><StackPanel Margin="26"><TextBlock Text="تنظیمات Sobhan Notification Hub" FontSize="24" FontWeight="Bold"/><Border Background="#EEF7F9" CornerRadius="10" Padding="16" Margin="0,16"><StackPanel><TextBlock x:Name="ConnectionText" FontWeight="Bold"/><TextBlock x:Name="UserText" Margin="0,7"/><TextBlock x:Name="SiteText"/><TextBlock x:Name="PollText" Margin="0,7"/></StackPanel></Border><CheckBox x:Name="StartupCheck" Content="اجرا با شروع ویندوز" Margin="4,8"/><CheckBox x:Name="SoundCheck" Content="صدای اعلان محلی فعال باشد" Margin="4,8"/><CheckBox x:Name="BodyCheck" Content="در صورت اجازه سایت، متن اعلان نمایش داده شود" Margin="4,8"/><TextBlock Text="تنظیمات ماژول‌ها، اولویت و ساعات سکوت از سایت دریافت می‌شود." Margin="4,15" Foreground="#53636B"/><WrapPanel><Button Content="ذخیره تنظیمات محلی" Click="Save_Click"/><Button Content="تست اعلان" Click="Test_Click"/><Button Content="تنظیمات در سایت" Click="Site_Click"/><Button Content="قطع اتصال دستگاه" Click="Disconnect_Click"/></WrapPanel><TextBlock x:Name="StatusText" Margin="4,12" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Window>
