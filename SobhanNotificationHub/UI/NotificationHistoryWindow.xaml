<Window x:Class="SobhanNotificationHub.UI.NotificationHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="تاریخچه اعلان‌ها" Height="650" Width="980" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"><DockPanel Margin="20"><StackPanel DockPanel.Dock="Top"><TextBlock Text="تاریخچه اعلان‌ها" FontSize="24" FontWeight="Bold"/><WrapPanel Margin="0,12"><ComboBox x:Name="ModuleFilter" Width="180" SelectionChanged="Filter_Changed"><ComboBoxItem Content="همه" Tag="" IsSelected="True"/><ComboBoxItem Content="کارتابل" Tag="cartable"/><ComboBoxItem Content="تیکتینگ" Tag="ticketing"/><ComboBoxItem Content="پیام‌رسان" Tag="messenger"/><ComboBoxItem Content="منابع انسانی" Tag="hr"/><ComboBoxItem Content="فروش" Tag="sales"/><ComboBoxItem Content="مدیریت" Tag="management"/><ComboBoxItem Content="سیستم" Tag="system"/></ComboBox><CheckBox x:Name="UnreadOnly" Content="فقط خوانده‌نشده" Margin="16,8" Checked="Filter_Changed" Unchecked="Filter_Changed"/><Button Content="بروزرسانی" Click="Refresh_Click"/></WrapPanel></StackPanel><WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button Content="باز کردن" Click="Open_Click"/><Button Content="خوانده شد" Click="Read_Click"/></WrapPanel><DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="زمان" Binding="{Binding CreatedAt}" Width="150"/><DataGridTextColumn Header="ماژول" Binding="{Binding Module}" Width="100"/><DataGridTextColumn Header="اولویت" Binding="{Binding Priority}" Width="90"/><DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="220"/><DataGridTextColumn Header="متن امن" Binding="{Binding Body}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></Window>
